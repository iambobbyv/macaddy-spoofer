# ── macOS release signing & notarization ─────────────────────────────────
# Copy to `.env` and fill in (`.env` is gitignored — never commit it).
# Required ONLY for signed + notarized distribution builds.
# Local dev builds and unsigned CI builds skip notarization automatically
# when these are unset (see scripts/notarize.js).

# Apple ID email used with notarytool
APPLE_ID=you@example.com

# App-specific password from https://appleid.apple.com
# (NOT your Apple ID login password)
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 10-character Team ID from https://developer.apple.com/account
APPLE_TEAM_ID=ABCD123456

# (optional) Exact Developer ID Application certificate name in your Keychain,
# e.g. "Developer ID Application: Your Name (ABCD123456)"
# APPLE_ID_CERT=
